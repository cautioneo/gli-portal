                <td style="padding: 14px 18px; font-weight: 600;">Profils CDD, freelances, essai</td>
                <td style="padding: 14px 18px; color: #DC2626;">Refusés ou exclus en sinistre</td>
                <td style="padding: 14px 18px; background: #EEF2FF; color: #10B981; font-weight: 700;">100% Éligibles et Certifiés</td>
              </tr>
              <tr style="border-bottom: 1px solid #F1F5F9;">
