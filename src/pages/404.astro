---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Redirection en cours... | Cautioneo";
const pageDescription = "Redirection automatique vers le contenu le plus pertinent de Cautioneo.";
const pageCanonical = "https://cautioneo-gli.com/";
const pageNoindex = true;
---

<Layout title={pageTitle} description={pageDescription} canonical={pageCanonical} noindex={pageNoindex}>
  <script is:inline>
  (function() {
    var path = window.location.pathname.toLowerCase();
    
    // Normalize trailing slashes and .html
    if (path !== '/' && path.endsWith('/')) {
      path = path.slice(0, -1);
    }
    if (path.endsWith('.html')) {
      path = path.slice(0, -5);
    }
    
    // Smart legacy URL mapping for old cautioneo.com structures
    if (path.includes('/blog/') || path.includes('/guides/') || path.includes('/proprietaire/')) {
      var parts = path.split('/').filter(Boolean);
      var lastPart = parts[parts.length - 1];
      if (lastPart) {
        window.location.replace('https://cautioneo-gli.com/blog-' + lastPart);
        return;
      }
    }
    
    // Fallback redirect to homepage after 100ms
    setTimeout(function() {
      window.location.replace('https://cautioneo-gli.com/');
    }, 100);
  })();
</script>

<header class="page-hero vh-80 flex-center">
  <div class="container text-center">
    <span class="badge mb-24">Redirection automatique</span>
    <h1 class="text-huge">Page déplacée</h1>
    <p class="text-lg mb-48 mx-auto max-w-700">Vous allez être réorienté automatiquement vers le contenu mis à jour...</p>
    <div class="flex-center gap-16">
      <a class="btn btn-primary" href="/">Retour immédiat à l'accueil</a>
      <a class="btn btn-outline-white" href="/blog">Consulter nos articles</a>
    </div>
  </div>
</header></Layout>
