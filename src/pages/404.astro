---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Page Non Trouvée | Cautioneo GLI";
const pageDescription = "La page demandée n'existe pas ou a été déplacée. Retournez à l'accueil de Cautioneo GLI.";
const pageCanonical = "https://cautioneo-gli.com/404";
const pageNoindex = true;
---

<Layout title={pageTitle} description={pageDescription} canonical={pageCanonical} noindex={pageNoindex}>
  <script is:inline>
  (function() {
    var pathname = window.location.pathname;
    if (pathname !== '/' && pathname.endsWith('/')) {
      var cleanSlash = pathname.slice(0, -1);
      window.location.replace(window.location.origin + cleanSlash + window.location.search + window.location.hash);
      return;
    }
    if (pathname.endsWith('.html')) {
      var cleanHtml = pathname.slice(0, -5);
      if (cleanHtml === '/index') cleanHtml = '/';
      window.location.replace(window.location.origin + cleanHtml + window.location.search + window.location.hash);
      return;
    }
  })();
  </script>

  <header class="page-hero vh-80 flex-center">
    <div class="container text-center">
      <span class="badge mb-24">Erreur 404</span>
      <h1 class="text-huge">Page introuvable</h1>
      <p class="text-lg mb-48 mx-auto max-w-700">La page que vous cherchez n'existe pas ou a été déplacée lors de notre mise à jour.</p>
      <div class="flex-center gap-16">
        <a class="btn btn-primary" href="/">Retour immédiat à l'accueil</a>
        <a class="btn btn-outline-white" href="/blog">Consulter nos articles</a>
      </div>
    </div>
  </header>
</Layout>
