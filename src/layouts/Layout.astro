                        <button data-lang="es" class="lang-opt">ES - Español</button>
                        <button data-lang="pt" class="lang-opt">PT - Português</button>
                        <button data-lang="it" class="lang-opt">IT - Italiano</button>
                        <button data-lang="de" class="lang-opt">DE - Deutsch</button>
                        <button data-lang="ar" class="lang-opt">AR - العربية</button>
                        <button data-lang="nl" class="lang-opt">NL - Nederlands</button>
                    </div>
                </div>
                <a class="btn btn-outline nav-btn-client" href="https://www.cautioneo.com/r/?referral_id=1b7fa16f-a353-4ff5-b28a-7b6886318826&kind=lessor&returnUrl=https%3A%2F%2Fpro.cautioneo.com%2Fpbi%2Fstart%2F" target="_blank">Espace Client</a>
                <a class="btn btn-primary" href="https://www.cautioneo.com/r/?referral_id=1b7fa16f-a353-4ff5-b28a-7b6886318826&kind=lessor&returnUrl=https%3A%2F%2Fpro.cautioneo.com%2Fpbi%2Fstart%2F" target="_blank">Sécuriser un loyer</a>
            </div>
        </div>
    </nav>

    <!-- Visual Breadcrumbs (Fil d'Ariane) -->
    {breadcrumbs && breadcrumbs.length > 0 && (
      <div class="breadcrumb-container">
        <div class="container">
          <nav aria-label="Breadcrumb" class="breadcrumb-nav">
            <ol class="breadcrumb-list">
              {breadcrumbs.map((bc, idx) => {
                const isLast = idx === breadcrumbs.length - 1;
                return (
                  <li class="breadcrumb-item">
