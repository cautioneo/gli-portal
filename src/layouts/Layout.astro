---
interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; item?: string }>;
  publishDate?: string;
  modifiedDate?: string;
  faqItems?: Array<{ question: string; answer: string }>;
  keywords?: string;
  aggregateRating?: {
    ratingValue: number;
    reviewCount: number;
    bestRating?: number;
  };
  image?: string;
  localBusiness?: {
    name: string;
    description: string;
    city: string;
    region: string;
    postalCode: string;
    telephone?: string;
  };
}

const { title, description, canonical, noindex = false, breadcrumbs, publishDate, modifiedDate, faqItems, keywords, aggregateRating, image, localBusiness } = Astro.props;
const siteUrl = "https://cautioneo-gli.com";
const canonicalUrl = new URL(canonical, Astro.site).href;
const isBlogPost = Astro.url.pathname.includes('/blog-') || Astro.url.pathname.includes('/guide-') || Astro.url.pathname.includes('/procedures') || Astro.url.pathname.includes('/fiscalite') || Astro.url.pathname.includes('/simulateur') || Astro.url.pathname.includes('/boite-a-outils') || Astro.url.pathname.includes('/checklist') || Astro.url.pathname.includes('/modeles') || Astro.url.pathname.includes('/mega-');
const defaultImage = "https://cautioneo-gli.com/logo.png";
const articleImage = image ? new URL(image, Astro.site).href : defaultImage;

const rawPath = Astro.url.pathname || '';
const pathWithoutLang = rawPath.replace(/^\/(en|es|pt|it|de|ar|nl)(\/|$)/, '/').replace(/\/$/, '');
const baseCleanPath = pathWithoutLang === '/' ? '' : pathWithoutLang;

const hreflangFr = `${siteUrl}${baseCleanPath}`;
const hreflangEn = `${siteUrl}/en${baseCleanPath}`;
const hreflangEs = `${siteUrl}/es${baseCleanPath}`;
const hreflangPt = `${siteUrl}/pt${baseCleanPath}`;
const hreflangIt = `${siteUrl}/it${baseCleanPath}`;
const hreflangDe = `${siteUrl}/de${baseCleanPath}`;
const hreflangAr = `${siteUrl}/ar${baseCleanPath}`;
const hreflangNl = `${siteUrl}/nl${baseCleanPath}`;
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: https:; font-src 'self' https: data:; frame-src 'self' https:;">
    <title>{title}</title>
    <meta name="description" content={description}/>
    {keywords && <meta name="keywords" content={keywords}/>}
    <link rel="canonical" href={canonicalUrl}/>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- International SEO: Hreflang annotations for all 8 supported languages -->
    <link rel="alternate" hreflang="fr" href={hreflangFr} />
    <link rel="alternate" hreflang="en" href={hreflangEn} />
    <link rel="alternate" hreflang="es" href={hreflangEs} />
    <link rel="alternate" hreflang="pt" href={hreflangPt} />
    <link rel="alternate" hreflang="it" href={hreflangIt} />
    <link rel="alternate" hreflang="de" href={hreflangDe} />
    <link rel="alternate" hreflang="ar" href={hreflangAr} />
    <link rel="alternate" hreflang="nl" href={hreflangNl} />
    <link rel="alternate" hreflang="x-default" href={hreflangFr} />

    <meta content={noindex ? "noindex, follow" : "index, follow"} name="robots"/>
    <meta content="Cautioneo" name="author"/>
    <meta content="Cautioneo" name="publisher"/>
    
    <!-- Open Graph / Facebook -->
    <meta content={isBlogPost ? "article" : "website"} property="og:type"/>
    <meta content={canonicalUrl} property="og:url"/>
    <meta content={title} property="og:title"/>
    <meta content={description} property="og:description"/>
    <meta content={articleImage} property="og:image"/>
    
    <!-- Twitter -->
    <meta content="summary_large_image" name="twitter:card"/>
    <meta content={canonicalUrl} name="twitter:url"/>
    <meta content={title} name="twitter:title"/>
    <meta content={description} name="twitter:description"/>
    <meta content={articleImage} name="twitter:image"/>


    <link rel="preload" href="/fonts/inter-v18-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/outfit-v18-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts.css" />
    <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    </noscript>
    
    {breadcrumbs && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((bc, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "name": bc.name,
          ...(bc.item ? { "item": bc.item } : {})
        }))
      })} />
    )}

    {faqItems && faqItems.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer
          }
        }))
      })} />
    )}

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />

    {isBlogPost && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": title,
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [".snippet-answer", ".article-intro", ".intro-box"]
        }
      })} />
    )}
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "description": description,
        "image": articleImage,
        "url": canonicalUrl,
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": canonicalUrl
        },
        "author": {
          "@type": "Organization",
          "name": "L'Equipe Cautioneo",
          "url": "https://cautioneo-gli.com"
        },
        "publisher": {
          "@type": "Organization",
          "name": "Cautioneo",
          "url": "https://cautioneo-gli.com",
          "logo": {
            "@type": "ImageObject",
            "url": "https://cautioneo-gli.com/logo.png"
          }
        },
        "datePublished": publishDate || "2026-05-26",
        "dateModified": modifiedDate || publishDate || "2026-06-15",
        "inLanguage": "fr-FR",
        "isPartOf": {
          "@type": "Blog",
          "name": "Blog Cautioneo - Conseils Propriétaires Bailleurs & GLI",
          "url": "https://cautioneo-gli.com/blog"
        }
      })} />
    )}

    {Astro.url.pathname === '/' || Astro.url.pathname === '/index.html' ? (
      <>
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": "Cautioneo GLI",
          "url": "https://cautioneo-gli.com",
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://cautioneo-gli.com/?s={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        })} />
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": "Cautioneo",
          "url": "https://www.cautioneo.com",
          "logo": "https://cautioneo-gli.com/logo.png",
          "sameAs": [
            "https://www.facebook.com/cautioneo",
            "https://www.linkedin.com/company/cautioneo"
          ]
        })} />
      </>
    ) : (
      !isBlogPost && (
        <script type="application/ld+json" set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": title,
          "description": description,
          "url": canonicalUrl,
          "isPartOf": {
            "@type": "WebSite",
            "url": "https://cautioneo-gli.com"
          }
        })} />
      )
    )}

    {localBusiness && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "InsuranceAgency",
        "name": localBusiness.name,
        "description": localBusiness.description,
        "url": canonicalUrl,
        "image": "https://cautioneo-gli.com/logo.png",
        "telephone": localBusiness.telephone || "+33 9 72 10 40 40",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": localBusiness.city,
          "addressRegion": localBusiness.region,
          "postalCode": localBusiness.postalCode,
          "addressCountry": "FR"
        },
        "sameAs": [
          "https://share.google/1GIqfuIovN1OjliaE",
          "https://www.facebook.com/cautioneo",
          "https://www.linkedin.com/company/cautioneo"
        ]
      })} />
    )}

    {aggregateRating && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Product",
        "name": title,
        "description": description,
        "url": canonicalUrl,
        "image": "https://cautioneo-gli.com/logo.png",
        "sku": "cautioneo-gli-portal",
        "mpn": "cautioneo-gli-portal",
        "brand": {
          "@type": "Brand",
          "name": "Cautioneo GLI"
        },
        "offers": {
          "@type": "Offer",
          "price": "0.00",
          "priceCurrency": "EUR",
          "availability": "https://schema.org/InStock",
          "url": canonicalUrl,
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
          },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "FR"
            },
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": 0,
              "currency": "EUR"
            }
          }
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": aggregateRating.ratingValue,
          "reviewCount": aggregateRating.reviewCount,
          "bestRating": aggregateRating.bestRating || 5,
          "worstRating": 1
        }
      })} />
    )}

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5HGD8NV2');
    </script>
    <!-- End Google Tag Manager -->

    <!-- Critical CSS Inlining for B2B Bailleurs -->
    <style is:inline>
      :root {
        --primary: #6c5ce7;
        --primary-dark: #5b4ddb;
        --primary-light: #f1efff;
        --primary-rgb: 108,92,231;
        --bg-main: #ffffff;
        --bg-subtle: #f9f8ff;
        --bg-dark: #6c5ce7;
        --text-main: #2b254d;
        --text-muted: #787399;
        --border: #e8e6f5;
        --accent: #ffb86c;
        --accent-light: #fff5e8;
        --font-heading: 'Outfit','Inter',sans-serif;
        --font-sans: 'Inter',system-ui,-apple-system,sans-serif;
        --shadow-sm: 0 4px 15px rgba(108,92,231,0.05);
        --shadow-md: 0 10px 30px rgba(108,92,231,0.08);
        --shadow-lg: 0 20px 40px rgba(108,92,231,0.12);
        --radius: 50px;
        --radius-lg: 24px;
      }
