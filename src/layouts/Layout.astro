    <!-- Footer B2B -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col" style="grid-column: span 2;">
                    <div class="logo-wrapper mb-16" style="flex: none; gap: 8px; display: flex; align-items: center;">
                        <img alt="Cautioneo" class="header-logo" loading="eager" src="/logo.png" style="filter: brightness(0) invert(1); height: 32px; width: auto;" decoding="async" width="160" height="32">
                        <span class="logo-text" style="color: white; font-size: 1.6rem; font-weight: 700;">Bailleurs</span>
