                    <div class="trust-badges-footer">
                        <a class="trust-badge-pill" href="https://www.avis-verifies.com/avis-clients/cautioneo.com" target="_blank" rel="noopener" title="Voir les avis de Cautioneo sur Avis Vérifiés">
                            <span style="color: #ffb020; display: flex; gap: 1px;">
                                <i class="fas fa-star" style="font-size: 0.75rem;"></i>
